# HTTP (80) - challenge + redirect
server {
  listen 80;
  server_name orto-protesi.com www.orto-protesi.com;

  # ACME challenge
  location ^~ /.well-known/acme-challenge/ {
    root /var/www/certbot;
    default_type "text/plain";
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

# HTTPS (443)
server {
  listen 443 ssl http2;
  server_name orto-protesi.com www.orto-protesi.com;

  # Certificati (saranno creati da certbot)
  ssl_certificate     /etc/letsencrypt/live/orto-protesi.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/orto-protesi.com/privkey.pem;

  # SSL hardening minimo
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers on;

  # Static SPA
  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml;

  location / {
    try_files $uri $uri/ /index.html;
  }

  # Security headers
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header X-XSS-Protection "1; mode=block" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

  # HSTS: abilitalo dopo aver verificato bene HTTPS (facoltativo)
  # add_header Strict-Transport-Security "max-age=15552000; includeSubDomains" always;
}
