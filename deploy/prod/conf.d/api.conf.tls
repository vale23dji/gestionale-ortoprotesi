# HTTP (80) - challenge + redirect
server {
  listen 80;
  server_name api.orto-protesi.com;

  location ^~ /.well-known/acme-challenge/ {
    root /var/www/certbot;
    default_type "text/plain";
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

# HTTPS (443)
server {
  listen 443 ssl http2;
  server_name api.orto-protesi.com;

  ssl_certificate     /etc/letsencrypt/live/api.orto-protesi.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/api.orto-protesi.com/privkey.pem;

  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers on;

  client_max_body_size 50m;  # upload confortevole

  # Proxy verso API .NET
  location / {
    proxy_pass         http://api:5000;
    proxy_http_version 1.1;
    proxy_set_header   Host $host;
    proxy_set_header   X-Real-IP $remote_addr;
    proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto https;
    proxy_buffering    off;
  }

  # Static /uploads (serviti direttamente se preferisci)
  location /uploads/ {
    proxy_pass http://api:5000/uploads/;
    proxy_set_header   Host $host;
    proxy_set_header   X-Real-IP $remote_addr;
    proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto https;
  }

  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header X-XSS-Protection "1; mode=block" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
}
